{
  "name": "AZ-104 Complete Learning Environment",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1.3.0": {
      "version": "2.88.0",
      "installBicep": true,
      "bicepVersion": "v0.46.1"
    },
    "ghcr.io/devcontainers/features/powershell:2.0.2": {
      "version": "7.4"
    },
    "ghcr.io/devcontainers/features/python:1.8.0": {
      "version": "3.12",
      "installTools": false
    },
    "ghcr.io/devcontainers/features/node:2.1.0": {
      "version": "22"
    }
  },
  "remoteEnv": {
    "AZURE_CORE_COLLECT_TELEMETRY": "no",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "PATH": "${containerEnv:HOME}/.az104-tools/azcopy:${containerEnv:PATH}",
    "PIP_DISABLE_PIP_VERSION_CHECK": "1",
    "POWERSHELL_TELEMETRY_OPTOUT": "1"
  },
  "postCreateCommand": "pwsh -NoLogo -NoProfile -File tools/Initialize-LabEnvironment.ps1 -InstallDependencies -OfflineOnly",
  "waitFor": "postCreateCommand",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.azure-account",
        "ms-vscode.azurecli",
        "ms-vscode.powershell",
        "ms-azuretools.vscode-bicep",
        "redhat.vscode-yaml",
        "davidanson.vscode-markdownlint",
        "streetsidesoftware.code-spell-checker",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/python/current/bin/python",
        "terminal.integrated.defaultProfile.linux": "pwsh"
      }
    }
  },
  "remoteUser": "vscode",
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "16gb"
  }
}
