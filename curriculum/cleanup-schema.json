{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jamonygr.github.io/az104-azure-administrator-labs/schemas/cleanup-schema.json",
  "title": "AZ-104 cleanup result",
  "type": "object",
  "required": [
    "schemaVersion",
    "labId",
    "runId",
    "generatedAt",
    "executionMode",
    "result",
    "ownershipVerified",
    "actions",
    "residualChecks",
    "activeManagedObjects",
    "retainedItems"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "labId": { "type": "string", "pattern": "^LAB-[0-9]{2}$" },
    "runId": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "executionMode": { "enum": ["preview", "execute"] },
    "result": { "enum": ["preview", "pass", "fail"] },
    "ownershipVerified": { "type": "boolean" },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    },
    "residualChecks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/residualCheck" }
    },
    "activeManagedObjects": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "retainedItems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "reason", "expectedDisposition"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 2 },
          "reason": { "type": "string", "minLength": 15 },
          "expectedDisposition": { "type": "string", "minLength": 10 }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "executionMode": { "const": "preview" } }, "required": ["executionMode"] },
      "then": { "properties": { "result": { "const": "preview" } } }
    },
    {
      "if": { "properties": { "result": { "const": "pass" } }, "required": ["result"] },
      "then": {
        "properties": {
          "executionMode": { "const": "execute" },
          "ownershipVerified": { "const": true },
          "activeManagedObjects": { "maxItems": 0 },
          "actions": {
            "items": {
              "properties": {
                "ownership": {
                  "properties": { "verified": { "const": true } }
                },
                "status": { "enum": ["deleted", "soft-deleted", "retained", "skipped"] }
              }
            }
          },
          "residualChecks": {
            "items": { "properties": { "status": { "const": "pass" } } }
          }
        }
      }
    },
    {
      "if": { "properties": { "result": { "const": "fail" } }, "required": ["result"] },
      "then": {
        "anyOf": [
          { "properties": { "ownershipVerified": { "const": false } } },
          { "properties": { "activeManagedObjects": { "minItems": 1 } } },
          {
            "properties": {
              "actions": {
                "contains": { "properties": { "status": { "const": "failed" } }, "required": ["status"] }
              }
            }
          },
          {
            "properties": {
              "residualChecks": {
                "contains": { "properties": { "status": { "const": "fail" } }, "required": ["status"] }
              }
            }
          }
        ]
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "checkpointId": { "type": "string", "pattern": "^LAB[0-9]{2}-CP0[1-5]$" },
    "action": {
      "type": "object",
      "required": ["checkpointId", "targetId", "targetType", "ownership", "status", "message"],
      "properties": {
        "checkpointId": { "$ref": "#/$defs/checkpointId" },
        "targetId": { "type": "string", "minLength": 1 },
        "targetType": { "type": "string", "minLength": 2 },
        "ownership": {
          "type": "object",
          "required": ["method", "verified"],
          "properties": {
            "method": { "enum": ["manifest-id", "manifest-id-and-tags", "local-path"] },
            "verified": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "status": { "enum": ["preview", "deleted", "soft-deleted", "retained", "skipped", "failed"] },
        "message": { "type": "string", "minLength": 5 }
      },
      "additionalProperties": false
    },
    "residualCheck": {
      "type": "object",
      "required": ["id", "command", "expected", "actual", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9-]+)+$" },
        "command": { "type": "string", "minLength": 5 },
        "expected": { "type": "string", "minLength": 3 },
        "actual": { "type": "string" },
        "status": { "enum": ["pass", "fail", "skipped"] }
      },
      "additionalProperties": false
    }
  }
}
