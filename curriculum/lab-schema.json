{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/az104/lab-schema.json",
  "title": "AZ-104 lab metadata",
  "type": "object",
  "required": [
    "id",
    "slug",
    "title",
    "blueprintVersion",
    "domain",
    "objectives",
    "track",
    "status",
    "estimatedMinutes",
    "cost",
    "permissions",
    "prerequisites",
    "validation",
    "screenshotStatus",
    "cleanup"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^LAB-[0-9]{2}$" },
    "slug": { "type": "string", "pattern": "^[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 5 },
    "blueprintVersion": { "type": "string", "format": "date" },
    "domain": { "type": "string", "minLength": 2 },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(?:FD|IG|ST|CO|NW|MM)-[A-Z]+-[0-9]{2}$" }
    },
    "track": { "type": "string", "minLength": 2 },
    "status": {
      "enum": ["planned", "in-progress", "offline-validated", "live-verified", "partial", "blocked"]
    },
    "estimatedMinutes": { "type": "integer", "minimum": 15 },
    "cost": {
      "type": "object",
      "required": ["class", "billableResources"],
      "properties": {
        "class": { "enum": ["none", "low", "moderate", "elevated"] },
        "billableResources": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "permissions": { "type": "object" },
    "prerequisites": { "type": "array", "items": { "type": "string" } },
    "validation": { "type": "object" },
    "screenshotStatus": { "enum": ["pending", "captured", "sanitized", "verified"] },
    "cleanup": { "type": "object" },
    "lastOfflineValidated": { "type": ["string", "null"], "format": "date" },
    "lastLiveVerified": { "type": ["string", "null"], "format": "date" }
  },
  "additionalProperties": true
}
