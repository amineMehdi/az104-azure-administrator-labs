{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/az104/question-schema.json",
  "title": "AZ-104 lab question list",
  "type": "array",
  "minItems": 10,
  "maxItems": 10,
  "items": {
    "type": "object",
    "required": [
      "id",
      "objectiveIds",
      "difficulty",
      "stem",
      "options",
      "correctOption",
      "explanation",
      "distractorExplanations",
      "sourceUrls",
      "lastVerified"
    ],
    "properties": {
      "id": { "type": "string", "pattern": "^LAB[0-9]{2}-Q(?:0[1-9]|10)$" },
      "objectiveIds": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string" }
      },
      "difficulty": { "enum": ["foundational", "applied", "advanced"] },
      "stem": { "type": "string", "minLength": 20 },
      "options": {
        "type": "object",
        "required": ["A", "B", "C", "D"],
        "properties": {
          "A": { "type": "string", "minLength": 2 },
          "B": { "type": "string", "minLength": 2 },
          "C": { "type": "string", "minLength": 2 },
          "D": { "type": "string", "minLength": 2 }
        },
        "additionalProperties": false
      },
      "correctOption": { "enum": ["A", "B", "C", "D"] },
      "explanation": { "type": "string", "minLength": 20 },
      "distractorExplanations": {
        "type": "object",
        "required": ["A", "B", "C", "D"],
        "properties": {
          "A": { "type": "string", "minLength": 8 },
          "B": { "type": "string", "minLength": 8 },
          "C": { "type": "string", "minLength": 8 },
          "D": { "type": "string", "minLength": 8 }
        },
        "additionalProperties": false
      },
      "sourceUrls": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "format": "uri", "pattern": "^https://learn\\.microsoft\\.com/" }
      },
      "lastVerified": { "type": "string", "format": "date" }
    },
    "additionalProperties": false
  }
}
