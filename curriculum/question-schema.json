{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jamonygr.github.io/az104-azure-administrator-labs/schemas/question-schema.json",
  "title": "AZ-104 lab assessment question list",
  "type": "array",
  "minItems": 50,
  "maxItems": 50,
  "items": {
    "type": "object",
    "required": [
      "id",
      "objectiveIds",
      "checkpointIds",
      "remediationAnchor",
      "difficulty",
      "stem",
      "options",
      "correctOption",
      "optionExplanations",
      "sources",
      "lastVerified"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^LAB(?:0[1-9]|1[0-9]|2[0-5])-Q(?:0[1-9]|[1-4][0-9]|50)$"
      },
      "objectiveIds": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^(?:IG|ST|CP|NW|MR)-[A-Z]+-[0-9]{2}$"
        }
      },
      "checkpointIds": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^LAB(?:0[1-9]|1[0-9]|2[0-5])-CP0[1-5]$"
        }
      },
      "remediationAnchor": {
        "type": "string",
        "pattern": "^#task-[1-5]$"
      },
      "difficulty": {
        "enum": ["foundational", "applied", "advanced"]
      },
      "stem": {
        "type": "string",
        "minLength": 40
      },
      "options": {
        "type": "object",
        "required": ["A", "B", "C", "D"],
        "properties": {
          "A": {"type": "string", "minLength": 12},
          "B": {"type": "string", "minLength": 12},
          "C": {"type": "string", "minLength": 12},
          "D": {"type": "string", "minLength": 12}
        },
        "additionalProperties": false
      },
      "correctOption": {
        "enum": ["A", "B", "C", "D"]
      },
      "optionExplanations": {
        "type": "object",
        "required": ["A", "B", "C", "D"],
        "properties": {
          "A": {"type": "string", "minLength": 30},
          "B": {"type": "string", "minLength": 30},
          "C": {"type": "string", "minLength": 30},
          "D": {"type": "string", "minLength": 30}
        },
        "additionalProperties": false
      },
      "sources": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "object",
          "required": ["title", "url"],
          "properties": {
            "title": {"type": "string", "minLength": 12},
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://learn\\.microsoft\\.com/"
            }
          },
          "additionalProperties": false
        }
      },
      "lastVerified": {
        "type": "string",
        "format": "date"
      }
    },
    "additionalProperties": false
  }
}
