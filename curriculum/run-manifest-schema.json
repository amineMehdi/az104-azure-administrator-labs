{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jamonygr.github.io/az104-azure-administrator-labs/schemas/run-manifest-schema.json",
  "title": "AZ-104 lab run manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "labId",
    "runId",
    "createdAt",
    "updatedAt",
    "status",
    "context",
    "acknowledgements",
    "inputs",
    "checkpointStates",
    "managedObjects",
    "originalSettings"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "labId": { "$ref": "#/$defs/labId" },
    "runId": { "$ref": "#/$defs/runId" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "status": {
      "enum": [
        "initialized",
        "setup-in-progress",
        "setup-complete",
        "partial",
        "failed",
        "cleanup-in-progress",
        "cleaned"
      ]
    },
    "context": {
      "type": "object",
      "required": ["cloud", "tenantId", "subscriptionId"],
      "properties": {
        "cloud": { "type": "string", "minLength": 3 },
        "tenantId": { "$ref": "#/$defs/guidOrLocal" },
        "subscriptionId": { "$ref": "#/$defs/guidOrLocal" }
      },
      "additionalProperties": false
    },
    "acknowledgements": {
      "type": "object",
      "required": ["cost", "tenantChange"],
      "properties": {
        "cost": { "type": "boolean" },
        "tenantChange": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "description": "Resolved non-secret inputs only.",
      "propertyNames": { "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
      "additionalProperties": { "type": ["string", "number", "integer", "boolean", "null"] }
    },
    "checkpointStates": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["checkpointId", "required", "status", "updatedAt"],
        "properties": {
          "checkpointId": { "$ref": "#/$defs/checkpointId" },
          "required": { "type": "boolean" },
          "status": { "enum": ["pending", "in-progress", "pass", "fail", "skipped"] },
          "updatedAt": { "type": "string", "format": "date-time" },
          "message": { "type": "string", "minLength": 3 }
        },
        "additionalProperties": false
      }
    },
    "managedObjects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "checkpointId",
          "kind",
          "id",
          "name",
          "type",
          "ownership",
          "recordedAt",
          "lifecycleStatus"
        ],
        "properties": {
          "checkpointId": { "$ref": "#/$defs/checkpointId" },
          "kind": { "enum": ["azure-resource", "entra-object", "shared-setting", "local-artifact"] },
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 2 },
          "scope": { "type": ["string", "null"] },
          "ownership": {
            "type": "object",
            "required": ["method", "expectedTags"],
            "properties": {
              "method": { "enum": ["manifest-id", "manifest-id-and-tags", "local-path"] },
              "expectedTags": {
                "type": "object",
                "propertyNames": { "enum": ["purpose", "labId", "runId", "expiresOn"] },
                "additionalProperties": { "type": "string" }
              }
            },
            "additionalProperties": false
          },
          "recordedAt": { "type": "string", "format": "date-time" },
          "lifecycleStatus": { "enum": ["active", "deleted", "soft-deleted", "retained", "unknown"] }
        },
        "additionalProperties": false
      }
    },
    "originalSettings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["checkpointId", "targetId", "property", "value", "recordedAt"],
        "properties": {
          "checkpointId": { "$ref": "#/$defs/checkpointId" },
          "targetId": { "type": "string", "minLength": 1 },
          "property": { "type": "string", "minLength": 1 },
          "value": {},
          "recordedAt": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "setup-complete" } }, "required": ["status"] },
      "then": {
        "properties": {
          "checkpointStates": {
            "items": { "properties": { "status": { "const": "pass" } } }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "partial" } }, "required": ["status"] },
      "then": {
        "properties": {
          "checkpointStates": {
            "contains": {
              "properties": { "status": { "const": "skipped" }, "required": { "const": false } },
              "required": ["status", "required"]
            },
            "allOf": [
              {
                "not": {
                  "contains": {
                    "properties": { "status": { "const": "skipped" }, "required": { "const": true } },
                    "required": ["status", "required"]
                  }
                }
              },
              {
                "not": {
                  "contains": {
                    "properties": { "status": { "const": "fail" } },
                    "required": ["status"]
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
      "then": {
        "properties": {
          "checkpointStates": {
            "contains": { "properties": { "status": { "const": "fail" } }, "required": ["status"] }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "cleaned" } }, "required": ["status"] },
      "then": {
        "properties": {
          "managedObjects": {
            "items": {
              "properties": {
                "lifecycleStatus": { "enum": ["deleted", "soft-deleted", "retained"] }
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "labId": { "type": "string", "pattern": "^LAB-[0-9]{2}$" },
    "runId": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$" },
    "checkpointId": { "type": "string", "pattern": "^LAB[0-9]{2}-CP0[1-5]$" },
    "guidOrLocal": {
      "oneOf": [
        { "type": "string", "format": "uuid" },
        { "const": "local" }
      ]
    }
  }
}
